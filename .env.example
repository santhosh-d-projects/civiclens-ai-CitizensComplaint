# Complaint-Sathi — environment variables
# Copy to .env.local for local dev. NEVER commit .env.local.
# Production + Preview values go in Vercel → Settings → Environment Variables.

# Supabase project: complaint-sathi (ref vilqhhvimmzuibwkqqll, ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=https://vilqhhvimmzuibwkqqll.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI analysis (master prompt §8). Provider switch: anthropic | gemini.
# Default model is claude-haiku-5-5; Gemini verified working with gemini-3.5-flash-lite.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Audit log signing (Ed25519). Generated by scripts/gen-audit-key.ts.
# Private key as base64; key id must match the row in audit_keys.
AUDIT_SIGNING_PRIVATE_KEY=
AUDIT_KEY_ID=audit-2026-01

# App URL (used for auth redirects + invite links)
APP_URL=http://localhost:3000

# Email (optional; in dev, links are logged to the server console)
EMAIL_FROM=noreply@complaint-sathi.in
RESEND_API_KEY=

# Seed scripts only (run locally, never in Vercel env)
ADMIN_EMAIL=
ADMIN_PASSWORD=
